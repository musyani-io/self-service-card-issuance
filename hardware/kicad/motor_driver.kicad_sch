  (text_box "Features for this driver:\n> ULN2003A chip\n> 5 pin motors (28BYJ-48 specifically)\n> Dual power input (Jack and terminals)\n> Back - feed protection)\n\nImprovements - next version\n> Fuse protection (PTC)\n> Put MOSFETs for reverse polarity protection\n> Use 1 driver to drive up to other 4 of them. (One power source for all 5)\n> Add USB-C as power source. (Variaties)\n"
    (at 17.78 16.51 0) (size 54.61 27.94)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid 4404ed6c-77ed-4b30-9627-01564788165e)
